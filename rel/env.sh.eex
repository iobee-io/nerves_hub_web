#!/bin/sh

# Sets and enables heart (recommended only in daemon mode)
# case $RELEASE_COMMAND in
#   daemon*)
#     HEART_COMMAND="$RELEASE_ROOT/bin/$RELEASE_NAME $RELEASE_COMMAND"
#     export HEART_COMMAND
#     export ELIXIR_ERL_OPTIONS="-heart"
#     ;;
#   *)
#     ;;
# esac

# FLY_APP_NAME and FLY_PRIVATE_IP are injected by Fly.io on every machine --
# unlike APP_NAME/PRIVATE_IP/POD_IP, which nothing here ever set, silently
# skipping distributed Erlang on every boot.
if [ -n "$FLY_APP_NAME" ]; then
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="${FLY_APP_NAME}@${FLY_PRIVATE_IP}"

  # Fly's private network (6PN) is IPv6-only, so both distributed Erlang
  # (node-to-node) and Ecto need to be told to use it explicitly.
  export ERL_AFLAGS="-proto_dist inet6_tcp"
  export ECTO_IPV6="true"

  echo " Node name: $RELEASE_NODE"
else
  echo "FLY_APP_NAME is not set -- skipping distributed Erlang"
fi
